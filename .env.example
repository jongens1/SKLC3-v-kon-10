# Actual logistics schema. All query jobs are billed to d-log-bi-common.
GCP_PROJECT_ID=p-plat-datadf-l1st
BQ_BILLING_PROJECT=d-log-bi-common
BQ_DATASET=L1_LogisticsViews
BQ_TABLE=v_StoreJobLines
BQ_MODE=joined
BQ_LOCATION=europe-west4
BQ_JOBS_TABLE=v_StoreJobs
BQ_STATES_TABLE=v_StoreJobLineStates
BQ_STORES_TABLE=v_Stores

JOBLINE_ID_COLUMN=StoreJobLine_ID
CREATED_TIME_COLUMN=Created
PICKED_TIME_COLUMN=PickedDate
COLLECTION_TIME_COLUMN=DepartureLimitTime
BRANCH_ID_COLUMN=Branch_ID
STORE_ID_COLUMN=Store_ID
# In joined mode Job_Type is synthesized from native type/subtype/direction IDs.
JOB_TYPE_COLUMN=Job_Type
VERSION_COLUMN=load_timestamp

BRANCH_ID=6281
STORE_PATTERN=%SKLC3%
ALLOWED_JOB_TYPES=Expedícia - Standard,Distribúcia - LC,Distribúcia - POB
TIMEZONE=Europe/Bratislava
DEFAULT_LOGISTIC_START_TIME=06:00

# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json

# For one flat table, set BQ_MODE=flat and map its own columns, for example:
# GCP_PROJECT_ID=your-project-id
# BQ_DATASET=your_dataset
# BQ_TABLE=your_joblines_table
# JOBLINE_ID_COLUMN=JobLine_ID
# CREATED_TIME_COLUMN=Created_At
# PICKED_TIME_COLUMN=Picked_At
# COLLECTION_TIME_COLUMN=Collection_At
# JOB_TYPE_COLUMN=Job_Type
# VERSION_COLUMN=
